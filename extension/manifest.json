{
  "manifest_version": 3,
  "name": "Ultimate Turbo Downloader",
  "version": "1.4.2",
  "description": "IDM-style download manager: fast multi-connection downloads (aria2), videos from 1,800+ sites (yt-dlp), image grabber.",
  "author": "Nawod Madhuwantha",
  "homepage_url": "https://www.nawodmadhuwantha.com",
  "permissions": ["downloads", "storage", "cookies", "contextMenus", "notifications", "alarms", "webRequest", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["overlay.js"], "run_at": "document_idle" }
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ultimate Turbo Downloader",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
